{
  "$schema": "https://mintlify.com/docs.json",
  "name": "VisePag Docs",
  "theme": "mint",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://visepag.com"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#535af0",
    "light": "#8589f5",
    "dark": "#535af0"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dash.visepag.com/login"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentação",
        "groups": [
          {
            "group": "Início",
            "pages": ["index", "authentication", "quickstart"]
          },
          {
            "group": "Conceitos",
            "pages": [
              "concepts/ids",
              "concepts/status",
              "concepts/errors",
              "concepts/rate-limits",
              "concepts/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Visão Geral",
            "pages": ["api-reference/overview"]
          },
          {
            "group": "Cobranças",
            "pages": [
              "api-reference/payins/create-payin",
              "api-reference/payins/get-payin",
              "api-reference/payins/list-payins"
            ]
          },
          {
            "group": "Saques",
            "pages": ["api-reference/payouts/create-payout", "api-reference/payouts/get-payout"]
          },
          {
            "group": "Saldo",
            "pages": ["api-reference/balance/get-balance"]
          },
          {
            "group": "Webhooks",
            "pages": ["api-reference/webhooks/overview", "api-reference/webhooks/events"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://visepag.com"
    }
  },
  "api": {
    "mdx": {
      "server": "https://api.visepag.com/v1",
      "auth": {
        "method": "bearer"
      }
    }
  }
}
